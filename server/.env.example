# Reddit app credentials — https://www.reddit.com/prefs/apps (type: "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Reddit requires a unique, descriptive User-Agent or it throttles aggressively.
REDDIT_USER_AGENT=web:mentiondit:v2.0 (by /u/your_username)

# Optional — https://serper.dev (2500 free queries, no card).
# Reddit's own search collapses on long-tail queries ("best brunch in Toronto");
# with this key thread discovery goes through Google instead. Leave empty to fall
# back to Reddit search.
SERPER_API_KEY=

MENTIONDIT_PORT=8080
